{
  "name": "autoria-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "track": "tsx --disable-warning=ExperimentalWarning src/main.ts",
    "probe": "tsx --disable-warning=ExperimentalWarning src/main.ts --probe",
    "dashboard": "tsx --disable-warning=ExperimentalWarning src/dashboard/build.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
